# kk-payments-secrets — structure documentation only. No real values committed.
# This Secret is created imperatively (see k8s/README.md for the command)
# because Secret values must not be committed to git.
apiVersion: v1
kind: Secret
metadata:
  name: kk-payments-secrets
  namespace: kijani-project
type: Opaque
stringData:
  DB_PASSWORD: "<obtain from team>"
  STRIPE_API_KEY: "<obtain from team>"
  JWT_SECRET: "<obtain from team>"
